rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{document} {
      allow read, write: if true;
    }
    match /snapshots/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /notifications/{document} {
      allow read: if true;
      allow write: if true;
    }
  }
}